@model ErrorViewModel

@{
    ViewData["Title"] = "Erro";
}


@if (Context.Response.StatusCode == 404)
{
    <h1 class="text-danger">Página não encontrada</h1>

    <p>
        A página que procura não existe.
    </p>
}
else
{
    <h1 class="text-danger">Ocorreu um erro</h1>

    <p>
        Ocorreu um problema ao processar o seu pedido.
        Por favor, tente novamente mais tarde.
    </p>
}

<p>
    Se o problema persistir, contacte o administrador da biblioteca.
</p>

@if (Model != null && Model.ShowRequestId)
{
    <p>
        <strong>ID do pedido:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary">
    Voltar à página inicial
</a>