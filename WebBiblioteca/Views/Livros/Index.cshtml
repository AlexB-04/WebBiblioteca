@model IEnumerable<WebBiblioteca.Models.Livro>

@{
    ViewData["Title"] = "Livros";
}

<h1>Livros</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Funcionario"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Criar livro</a>
    </p>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <label for="pesquisa" class="form-label">Título, autor ou categoria</label>
        <input type="search" id="pesquisa" name="pesquisa" value="@ViewBag.Pesquisa"
               class="form-control" placeholder="Pesquisar livros" />
    </div>
    <div class="col-md-3">
        <label for="idCategoria" class="form-label">Categoria</label>
        <select id="idCategoria" name="idCategoria" class="form-select" asp-items="ViewBag.Categorias">
            <option value="">Todas as categorias</option>
        </select>
    </div>
    <div class="col-md-3">
        <label for="estado" class="form-label">Disponibilidade</label>
        <select id="estado" name="estado" class="form-select">
            <option value="">Todos os livros</option>
            <option value="Disponiveis" selected="@(ViewBag.Estado == "Disponiveis")">Disponíveis</option>
            <option value="Emprestados" selected="@(ViewBag.Estado == "Emprestados")">Emprestados</option>
            <option value="Reservados" selected="@(ViewBag.Estado == "Reservados")">Reservados</option>
        </select>
    </div>
    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary">Pesquisar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>Capa</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Editora</th>
                <th>Ano</th>
                <th>Género</th>
                <th>Exemplares na biblioteca</th>
                <th>Categoria</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@Url.Content(item.ImageUrl)"
                                 alt="Capa de @item.Titulo"
                                 style="width:70px;max-width:100%;height:auto;" />
                        }
                        else
                        {
                            <img src="@Url.Content("~/images/noimage.jpg")"
                                 alt="Livro sem capa"
                                 style="width:70px;max-width:100%;height:auto;" />
                        }
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Autor)</td>
                    <td>@Html.DisplayFor(modelItem => item.Editora)</td>
                    <td>@Html.DisplayFor(modelItem => item.AnoPublicacao)</td>
                    <td>@Html.DisplayFor(modelItem => item.Genero)</td>
                    <td>@Html.DisplayFor(modelItem => item.ExemplaresDisponiveis)</td>
                    <td>
                        @if (item.CategoriaAtual != null)
                        {
                            @item.CategoriaAtual.Nome
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.IdLivro" class="btn btn-primary">Detalhes</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Funcionario"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.IdLivro" class="btn btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdLivro" class="btn btn-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9">Não foram encontrados livros com os filtros indicados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>