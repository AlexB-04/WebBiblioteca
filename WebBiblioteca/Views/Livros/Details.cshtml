@model WebBiblioteca.Models.Livro

@{
    ViewData["Title"] = "Detalhes do livro";
}

<h1>Detalhes do livro</h1>

<div>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">
                    Título
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Titulo)
                </dd>

                <dt class="col-sm-3">
                    Autor
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Autor)
                </dd>

                <dt class="col-sm-3">
                    Editora
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Editora)
                </dd>

                <dt class="col-sm-3">
                    Ano de publicação
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.AnoPublicacao)
                </dd>

                <dt class="col-sm-3">
                    Género
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Genero)
                </dd>

                <dt class="col-sm-3">
                    Exemplares disponíveis
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ExemplaresDisponiveis)
                </dd>

                <dt class="col-sm-3">
                    Categoria
                </dt>
                <dd class="col-sm-9">
                    @if (Model.CategoriaAtual != null)
                    {
                        @Model.CategoriaAtual.Nome
                    }
                </dd>
            </dl>
        </div>

        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Url.Content(Model.ImageUrl)"
                     alt="Capa de @Model.Titulo"
                     style="width:300px;max-width:100%;height:auto" />
            }
            else
            {
                <img src="@Url.Content("~/images/noimage.jpg")"
                     alt="Livro sem capa"
                     style="width:300px;max-width:100%;height:auto" />
            }
        </div>
    </div>
</div>


@{
    DateTime? proximaDevolucao = ViewBag.ProximaDevolucao as DateTime?;

    int reservasEmEspera = ViewBag.ReservasEmEspera is int total
        ? total
        : 0;

    bool existemAtrasos = ViewBag.ExistemAtrasos is bool atrasos
        && atrasos;
}

<div class="card mt-3 mb-3">
    <div class="card-body">
        <h3 class="h5">Disponibilidade futura</h3>

        <dl class="row">
            <dt class="col-sm-4">Exemplares disponíveis</dt>
            <dd class="col-sm-8">
                @Model.ExemplaresDisponiveis
            </dd>

            <dt class="col-sm-4">Reservas em espera</dt>
            <dd class="col-sm-8">
                @reservasEmEspera
            </dd>

            <dt class="col-sm-4">Próxima devolução prevista</dt>
            <dd class="col-sm-8">
                @if (proximaDevolucao.HasValue)
                {
                    @proximaDevolucao.Value.ToString("dd/MM/yyyy")
                }
                else
                {
                    <span>Sem data futura prevista</span>
                }
            </dd>
        </dl>

        @if (existemAtrasos)
        {
            <p class="text-warning">
                Existem empréstimos com prazo de devolução ultrapassado.
            </p>
        }

        <p class="text-muted small mb-0">
            As datas são apenas previsões.
            A disponibilidade depende das devoluções
            e da ordem da fila de reservas.
        </p>
    </div>
</div>

<div>
    @if (User.IsInRole("Admin") || User.IsInRole("Funcionario"))
    {
        <a asp-action="Edit" asp-route-id="@Model.IdLivro" class="btn btn-warning">Editar</a>
    }
    @if (User.Identity?.IsAuthenticated != true || User.IsInRole("Leitor") || User.IsInRole("Funcionario"))
    {
        <a asp-controller="Reservas" asp-action="Create" asp-route-idLivro="@Model.IdLivro" class="btn btn-primary">Reservar livro</a>
    }
    @if (User.IsInRole("Leitor") || User.IsInRole("Funcionario"))
    {
        <a asp-controller="Reservas" asp-action="Index" class="btn btn-outline-primary">@(User.IsInRole("Funcionario") ? "Gerir reservas" : "As minhas reservas")</a>
    }
    <a asp-action="Index" class="btn btn-success">Voltar</a>
</div>