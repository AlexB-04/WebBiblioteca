@model WebBiblioteca.Models.LeitorViewModel

<div class="form-group mb-2">
    <label asp-for="Nome"></label>
    <input asp-for="Nome" class="form-control" />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>
@if (Model.TemConta)
{
    <div class="form-group mb-2">
        <label asp-for="Apelido"></label>
        <input asp-for="Apelido" class="form-control" required />
        <span asp-validation-for="Apelido" class="text-danger"></span>
    </div>
}
<div class="form-group mb-2">
    <label asp-for="Contacto"></label>
    <input asp-for="Contacto" class="form-control" />
    <span asp-validation-for="Contacto" class="text-danger"></span>
</div>
<div class="form-group mb-2">
    <label asp-for="Email"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="form-group mb-2">
    <label asp-for="TipoUtilizador"></label>
    <select asp-for="TipoUtilizador" class="form-control">
        <option value="">Selecione o tipo de leitor</option>
        <option value="Aluno">Aluno</option>
        <option value="Professor">Professor</option>
        <option value="Público em Geral">Público em Geral</option>
    </select>
    <span asp-validation-for="TipoUtilizador" class="text-danger"></span>
</div>
<div class="form-group mb-3">
    <label asp-for="LimiteEmprestimos"></label>
    <input asp-for="LimiteEmprestimos" type="number" min="0" class="form-control" />
    <span asp-validation-for="LimiteEmprestimos" class="text-danger"></span>
    <small class="text-muted">Número máximo de livros em empréstimo ao mesmo tempo.</small>
</div>