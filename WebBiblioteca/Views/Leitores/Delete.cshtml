@model WebBiblioteca.Models.Leitor
@{ ViewData["Title"] = "Eliminar leitor"; }

<h2>Eliminar leitor</h2>
<h3>Tem a certeza de que deseja eliminar este leitor?</h3>
<p>A ficha e a conta associada serão eliminadas. Não é possível eliminar leitores com empréstimos ativos ou histórico de empréstimos e reservas.</p>
<div asp-validation-summary="All" class="text-danger"></div>
<partial name="_Detalhes" model="Model" />
<form asp-action="Delete" asp-route-id="@Model.IdLeitor" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Details" asp-route-id="@Model.IdLeitor" class="btn btn-secondary">Voltar</a>
</form>