@model IEnumerable<WebBiblioteca.Models.Leitor>
@{ ViewData["Title"] = "Leitores"; }

<h2>Leitores</h2>
@if (TempData["LeitorMessage"] != null)
{
    <div class="alert alert-success">@TempData["LeitorMessage"]</div>
}
<p>Os novos leitores registam-se em Registar leitor. A conta é confirmada pelo administrador.</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <label for="pesquisa" class="form-label">Pesquisar por nome, código ou ID</label>
        <input type="search" id="pesquisa" name="pesquisa" value="@ViewBag.Pesquisa" class="form-control" />
    </div>
    <div class="col-md-auto align-self-end">
        <button type="submit" class="btn btn-primary">Pesquisar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover table-striped">
        <thead><tr><th>Código / ID</th><th>Nome</th><th>Contacto</th><th>Email</th><th>Tipo</th><th>Limite</th><th>Conta</th><th>Ações</th></tr></thead>
        <tbody>
        @foreach (var leitor in Model)
        {
            <tr>
                <td>@(leitor.CodigoLeitor ?? $"ID {leitor.IdLeitor}")</td>
                <td>@leitor.Nome</td>
                <td>@leitor.Contacto</td>
                <td>@leitor.Email</td>
                <td>@leitor.TipoUtilizador</td>
                <td>@leitor.LimiteEmprestimos</td>
                <td>
                    @if (leitor.UserId == null) { <span>Sem conta</span> }
                    else if (leitor.User?.Aprovado != true) { <span>Aguarda confirmação</span> }
                    else if (leitor.User.DeveAlterarPassword) { <span>Aguarda palavra-passe</span> }
                    else { <span>Ativa</span> }
                </td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@leitor.IdLeitor" class="btn btn-primary">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@leitor.IdLeitor" class="btn btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@leitor.IdLeitor" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="8">Não foram encontrados leitores.</td></tr>
        }
        </tbody>
    </table>
</div>