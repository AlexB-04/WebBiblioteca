@model WebBiblioteca.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Definir palavra-passe"; }
<h2>Definir palavra-passe</h2>
@if (string.IsNullOrWhiteSpace(Model.Token))
{
    <p>Para entrar, a conta deve estar confirmada e a palavra-passe deve ser definida através do link enviado por email.</p>
    <p>Se acabou de se registar como leitor, aguarde a confirmação do administrador. Caso contrário, verifique o email ou peça um novo link.</p>
    <a asp-action="RecoverPassword" class="btn btn-primary">Receber novo link</a>
}
else
{
    <p>Use pelo menos 6 caracteres, incluindo maiúscula, minúscula, número e símbolo.</p>
    <div class="row">
        <div class="col-md-4">
            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Confirm"></label>
                <input asp-for="Confirm" class="form-control" />
                <span asp-validation-for="Confirm" class="text-danger"></span>
            </div>
                <button type="submit" class="btn btn-success">Guardar palavra-passe</button>
            </form>
        </div>
    </div>
    <a asp-action="RecoverPassword">Pedir um novo link</a>
}
<p><a asp-action="Login">Voltar ao início de sessão</a></p>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}