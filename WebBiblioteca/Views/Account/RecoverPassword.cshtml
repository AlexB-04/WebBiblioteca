@model WebBiblioteca.Models.RecoverPasswordViewModel
@{ ViewData["Title"] = "Receber link de palavra-passe"; }
<h2>Receber link de palavra-passe</h2>
<p>Indique o email da conta. Os leitores precisam primeiro da confirmação do administrador.</p>
<p class="text-info">@ViewBag.Message</p>
<div class="row">
    <div class="col-md-4">
        <form asp-action="RecoverPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Enviar link</button>
                <a asp-action="Login" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}